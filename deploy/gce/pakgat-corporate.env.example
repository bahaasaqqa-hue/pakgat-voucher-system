# Pakgat Corporate Benefits — add these names to /etc/pakgat/pakgat.env when ready.
# Never commit real secrets.

# Safety switch. Keep false until Salla OAuth + SMTP + first company are ready.
CORPORATE_LIVE=false

# Dedicated HMAC secret for corporate flow tokens. Generate a long random value.
CORPORATE_SECRET=

# Public employee activation URL.
CORPORATE_PUBLIC_URL=https://benefits.pakgat.com/corporate

# OTP expiry (3-20 minutes allowed by code).
CORPORATE_OTP_MINUTES=10

# Transactional email / SMTP for employee OTP messages.
CORPORATE_SMTP_HOST=
CORPORATE_SMTP_PORT=587
CORPORATE_SMTP_USERNAME=
CORPORATE_SMTP_PASSWORD=
CORPORATE_SMTP_FROM=
CORPORATE_SMTP_SSL=false
CORPORATE_SMTP_STARTTLS=true

# Salla uses the existing app OAuth/token settings already stored by Pakgat.
# Required Salla scopes for activation:
# customers.read_write
# Optional later for automatic corporate discount offers:
# specialoffers.read_write
