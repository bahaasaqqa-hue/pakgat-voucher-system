# Copy to /etc/pakgat/pakgat.env on the VM and chmod 600.
# NEVER commit real secrets.

DATABASE_URL=postgresql://pakgat:CHANGE_DB_PASSWORD@127.0.0.1:5432/pakgat_voucher
PUBLIC_BASE_URL=https://voucher.pakgat.com

ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ADMIN_PASSWORD
ADMIN_SECRET=CHANGE_LONG_RANDOM_SECRET
COOKIE_SECURE=true

# Dedicated HMAC secret for merchant OTP session cookies. Generate a strong
# random value in production; do not reuse ADMIN_SECRET.
MERCHANT_PORTAL_SECRET=CHANGE_LONG_RANDOM_MERCHANT_PORTAL_SECRET

SALLA_WEBHOOK_SECRET=CHANGE_SALLA_WEBHOOK_SECRET
SALLA_ACCESS_TOKEN=
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
SALLA_OAUTH_TOKEN_URL=https://accounts.salla.sa/oauth2/token
SALLA_API_BASE_URL=https://api.salla.dev/admin/v2

VOUCHER_SKU_PREFIX=PKG-QR
MERCHANT_CODES={}
MERCHANT_NOTIFICATION_PIN=

WHATSLOOP_API_BASE_URL=
WHATSLOOP_API_TOKEN=

# GA4 numeric Property ID (not the G- measurement ID). Authentication uses
# the VM service account; grant its email Viewer access in the GA4 property.
GOOGLE_ANALYTICS_PROPERTY_ID=
GOOGLE_ANALYTICS_SERVICE_ACCOUNT=

# Search Console verified property. Grant the service account read access.
GOOGLE_SEARCH_CONSOLE_SITE_URL=sc-domain:pakgat.com
GOOGLE_SEARCH_CONSOLE_SERVICE_ACCOUNT=

# Optional SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
