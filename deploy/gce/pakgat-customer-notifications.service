[Unit]
Description=Pakgat customer notification outbox dispatcher
After=network-online.target pakgat-voucher.service

[Service]
Type=oneshot
User=pakgat
Group=pakgat
WorkingDirectory=/opt/pakgat-voucher-system
EnvironmentFile=/etc/pakgat/pakgat.env
ExecStart=/opt/pakgat-voucher-system/.venv/bin/python -m app.customer_notification_worker

[Install]
WantedBy=multi-user.target
