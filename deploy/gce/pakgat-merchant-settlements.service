[Unit]
Description=Pakgat weekly merchant settlement preparation
After=network-online.target pakgat-voucher.service

[Service]
Type=oneshot
User=pakgat
Group=pakgat
WorkingDirectory=/opt/pakgat-voucher-system
EnvironmentFile=/etc/pakgat/pakgat.env
ExecStart=/opt/pakgat-voucher-system/.venv/bin/python -m app.merchant_settlement_worker

[Install]
WantedBy=multi-user.target
